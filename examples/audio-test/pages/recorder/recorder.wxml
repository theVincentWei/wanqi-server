<view class="card">
  <view class="card-title">录音格式</view>
  <view class="rate-row">
    <view class="rate-chip {{format === 'aac' ? 'active' : ''}}" data-format="aac" bindtap="formatTapped">aac</view>
    <view class="rate-chip {{format === 'wav' ? 'active' : ''}}" data-format="wav" bindtap="formatTapped">wav</view>
  </view>
</view>

<view class="card">
  <view class="card-title">录音控制(start: duration=10000ms, 44100Hz, 单声道)</view>
  <view class="btn-row">
    <view class="btn {{recording ? 'disabled' : ''}}" bindtap="startTapped">start</view>
    <view class="btn secondary" bindtap="pauseTapped">pause</view>
    <view class="btn secondary" bindtap="resumeTapped">resume</view>
    <view class="btn danger" bindtap="stopTapped">stop</view>
  </view>
  <view class="btn-row" style="margin-top: 16rpx;">
    <view class="btn secondary" bindtap="invalidFormatTapped">非法格式试错(mp3)</view>
    <view class="btn secondary" bindtap="resetTapped">重置单例监听</view>
  </view>
  <view class="status-line" style="margin-top: 12rpx;"><text>状态</text><text class="value">{{stateText}}</text></view>
</view>

<view class="card">
  <view class="card-title">录音结果(onStop 载荷)</view>
  <block wx:if="{{result}}">
    <view class="status-line"><text>tempFilePath</text><text class="value result-path">{{result.tempFilePath}}</text></view>
    <view class="status-line"><text>duration(ms)</text><text class="value">{{result.duration}}</text></view>
    <view class="status-line"><text>fileSize(bytes)</text><text class="value">{{result.fileSize}}</text></view>
    <view class="btn-row" style="margin-top: 16rpx;">
      <view class="btn" bindtap="playResultTapped">回放录音</view>
      <view class="btn secondary" bindtap="stopPlayResultTapped">停止回放</view>
    </view>
  </block>
  <view wx:else class="status-line"><text>状态</text><text class="value">尚未录到文件(stop 成功后显示)</text></view>
</view>

<view class="card">
  <view class="card-title">事件面板(onStart/onPause/onStop/onError/onInterruptionBegin/onInterruptionEnd)</view>
  <view class="log-panel">
    <view class="log-item {{item.kind}}" wx:for="{{logs}}" wx:key="index">{{item.text}}</view>
    <view class="log-item" wx:if="{{logs.length === 0}}">(暂无事件;首次 start 会弹系统权限框,拒绝应走 onError auth deny)</view>
  </view>
  <view class="btn-row" style="margin-top: 16rpx;">
    <view class="btn secondary" bindtap="clearLogs">清空日志</view>
    <view class="btn" bindtap="goBack">← 返回播放页</view>
  </view>
</view>
