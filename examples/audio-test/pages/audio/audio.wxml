<view class="card">
  <view class="card-title">曲源</view>
  <view class="rate-row">
    <view class="rate-chip {{source === 'bundle' ? 'active' : ''}}" bindtap="useBundleSource">包内曲目</view>
    <view class="rate-chip {{source === 'net' ? 'active' : ''}}" bindtap="useNetSource">网络曲目(网关)</view>
  </view>
  <view class="status-line"><text>当前 src</text><text class="value src-text">{{srcText}}</text></view>
</view>

<view class="card">
  <view class="card-title">播放控制</view>
  <view class="btn-row">
    <view class="btn" bindtap="playTapped">播放</view>
    <view class="btn secondary" bindtap="pauseTapped">暂停</view>
    <view class="btn secondary" bindtap="stopTapped">停止</view>
  </view>
  <view class="btn-row" style="margin-top: 16rpx;">
    <view class="btn secondary" data-pos="0" bindtap="seekTapped">seek 0s</view>
    <view class="btn secondary" data-pos="2.5" bindtap="seekTapped">seek 2.5s</view>
    <view class="btn danger" bindtap="destroyTapped">destroy</view>
  </view>
</view>

<view class="card">
  <view class="card-title">属性</view>
  <view class="row">
    <text class="row-label">倍速 playbackRate</text>
    <view class="rate-row">
      <view class="rate-chip {{rate === 0.5 ? 'active' : ''}}" data-rate="0.5" bindtap="rateTapped">0.5x</view>
      <view class="rate-chip {{rate === 1 ? 'active' : ''}}" data-rate="1" bindtap="rateTapped">1x</view>
      <view class="rate-chip {{rate === 1.5 ? 'active' : ''}}" data-rate="1.5" bindtap="rateTapped">1.5x</view>
      <view class="rate-chip {{rate === 2 ? 'active' : ''}}" data-rate="2" bindtap="rateTapped">2x</view>
    </view>
  </view>
  <view class="row">
    <text class="row-label">音量 volume {{volume}}%</text>
    <slider style="width: 380rpx;" min="0" max="100" value="{{volume}}" activeColor="#1f6feb" bindchange="volumeChanged" />
  </view>
  <view class="row">
    <text class="row-label">循环 loop</text>
    <switch checked="{{loop}}" bindchange="loopChanged" />
  </view>
</view>

<view class="card">
  <view class="card-title">实时状态(500ms 轮询 getState)</view>
  <view class="status-line"><text>duration(s)</text><text class="value">{{durationText}}</text></view>
  <view class="status-line"><text>currentTime(s)</text><text class="value">{{currentTimeText}}</text></view>
  <view class="status-line"><text>paused</text><text class="value">{{pausedText}}</text></view>
</view>

<view class="card">
  <view class="card-title">事件面板(onCanplay/onPlay/onPause/onStop/onEnded/onTimeUpdate/onError/onWaiting/onSeeking/onSeeked/onLoadedmetadata)</view>
  <view class="log-panel">
    <view class="log-item {{item.kind}}" wx:for="{{logs}}" wx:key="index">{{item.text}}</view>
    <view class="log-item" wx:if="{{logs.length === 0}}">(暂无事件)</view>
  </view>
  <view class="btn-row" style="margin-top: 16rpx;">
    <view class="btn secondary" bindtap="clearLogs">清空日志</view>
    <view class="btn" bindtap="goRecorder">录音页 →</view>
  </view>
</view>
