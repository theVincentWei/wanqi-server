.page { padding: 32rpx 24rpx; }
.type-switch {
  display: flex; background: #eceef1; border-radius: 16rpx; padding: 8rpx; margin-bottom: 32rpx;
}
.opt {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx;
  font-size: 30rpx; color: #5b6470;
}
.opt.active.out { background: #fff; color: #d5474d; font-weight: 600; }
.opt.active.in { background: #fff; color: #0a7d54; font-weight: 600; }
.field { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.fname { font-size: 24rpx; color: #9aa1a9; margin-bottom: 12rpx; }
.amount-input { font-size: 48rpx; font-weight: 700; }
.note-input { font-size: 30rpx; }
.save {
  margin-top: 48rpx; background: #0a7d54; color: #fff; text-align: center;
  font-size: 32rpx; font-weight: 600; padding: 26rpx 0; border-radius: 16rpx;
}
