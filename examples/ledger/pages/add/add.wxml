<view class="page">
  <view class="type-switch">
    <view class="opt {{type === 'expense' ? 'active out' : ''}}" data-type="expense" bindtap="setType">支出</view>
    <view class="opt {{type === 'income' ? 'active in' : ''}}" data-type="income" bindtap="setType">收入</view>
  </view>

  <view class="field">
    <view class="fname">金额</view>
    <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" />
  </view>
  <view class="field">
    <view class="fname">备注</view>
    <input class="note-input" placeholder="花了什么 / 收了什么" value="{{note}}" bindinput="onNote" />
  </view>

  <view class="save" bindtap="save">保存</view>
</view>
