<view class="page">
  <view class="summary">
    <view class="cell">
      <view class="label">收入</view>
      <view class="value income">+{{incomeText}}</view>
    </view>
    <view class="cell">
      <view class="label">支出</view>
      <view class="value expense">-{{expenseText}}</view>
    </view>
    <view class="cell">
      <view class="label">结余</view>
      <view class="value">{{balanceText}}</view>
    </view>
  </view>

  <view class="list" wx:if="{{entries.length}}">
    <view class="row" wx:for="{{entries}}" wx:key="id">
      <view class="badge {{item.type === 'income' ? 'in' : 'out'}}">
        {{item.type === 'income' ? '收' : '支'}}
      </view>
      <view class="mid">
        <view class="note">{{item.note || '未备注'}}</view>
        <view class="date">{{item.dateText}}</view>
      </view>
      <view class="amount {{item.type === 'income' ? 'income' : 'expense'}}">
        {{item.type === 'income' ? '+' : '-'}}{{item.amountText}}
      </view>
    </view>
  </view>
  <view class="empty" wx:else>还没有记录,点「记一笔」开始吧</view>

  <view class="fab" bindtap="goAdd">记一笔</view>
</view>
