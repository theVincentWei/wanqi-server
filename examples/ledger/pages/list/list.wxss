.page { padding: 24rpx; padding-bottom: 200rpx; }
.summary {
  display: flex; background: #0a7d54; border-radius: 20rpx;
  padding: 32rpx 24rpx; color: #fff;
}
.cell { flex: 1; text-align: center; }
.label { font-size: 22rpx; opacity: 0.72; margin-bottom: 8rpx; }
.value { font-size: 34rpx; font-weight: 600; }
.value.income { color: #a7f3d0; }
.value.expense { color: #fecaca; }
.list { margin-top: 24rpx; background: #fff; border-radius: 20rpx; overflow: hidden; }
.row { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f0f1f3; }
.row:last-child { border-bottom: none; }
.badge {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; text-align: center;
  line-height: 56rpx; font-size: 26rpx; margin-right: 20rpx;
}
.badge.in { background: #e6f7ef; color: #0a7d54; }
.badge.out { background: #fdeaea; color: #d5474d; }
.mid { flex: 1; }
.note { font-size: 30rpx; }
.date { font-size: 22rpx; color: #9aa1a9; margin-top: 4rpx; }
.amount { font-size: 32rpx; font-weight: 600; }
.amount.income { color: #0a7d54; }
.amount.expense { color: #d5474d; }
.empty { margin-top: 80rpx; text-align: center; color: #9aa1a9; }
.fab {
  position: fixed; left: 50%; transform: translateX(-50%); bottom: 48rpx;
  background: #0a7d54; color: #fff; font-size: 32rpx; font-weight: 600;
  padding: 24rpx 96rpx; border-radius: 48rpx; box-shadow: 0 8rpx 24rpx rgba(10,125,84,0.35);
}
