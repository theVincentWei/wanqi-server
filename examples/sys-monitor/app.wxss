/* 系统监视器:深浅色双主题。
   定稿语义色单源(明暗同值):CPU 蓝 #2563EB / 内存橙 #F59E0B / 存储红 #EF4444。
   内容层深色由 JS 驱动(utils/theme.js 挂 .dark class):容器 WebView 的
   prefers-color-scheme 恒报 light(targetSdk<33),wxss 媒体查询不可用。 */
page {
  font-size: 28rpx;
}

.page {
  /* 深浅色变量:浅色为默认值,.dark 整组覆盖 */
  --bg: #F2F4F7;                         /* 页面底 */
  --card: #FFFFFF;                       /* 卡片底 */
  --fg: #111827;                         /* 主文字 */
  --fg2: #6B7280;                        /* 次级文字(标签/图例) */
  --fg3: #9CA3AF;                        /* 三级文字(提示/空态) */
  --track: #E5E7EB;                      /* 进度条轨道 */
  --chip: rgba(127, 127, 127, 0.12);     /* 段钮容器/图标章底 */
  --chip-soft: rgba(127, 127, 127, 0.06);/* 排名章底 */
  --seg-active: #FFFFFF;                 /* 段钮选中底 */
  --divider: rgba(127, 127, 127, 0.14);  /* 分隔线 */
  --shadow: rgba(16, 24, 40, 0.06);      /* 卡片投影 */
  --warn-bg: rgba(220, 38, 38, 0.08);    /* ≥85% 警示条底 */
  --warn-fg: #DC2626;                    /* 警示条文字 */

  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--fg);
}

.page.dark {
  --bg: #14161C;
  --card: #1E222B;
  --fg: #F3F5F8;
  --fg2: #A2A9B6;
  --fg3: #7C8593;
  --track: #2A2F3A;
  --chip: rgba(255, 255, 255, 0.08);
  --chip-soft: rgba(255, 255, 255, 0.06);
  --seg-active: #2E3441;
  --divider: rgba(127, 127, 127, 0.22);
  --shadow: rgba(0, 0, 0, 0.35);
  --warn-bg: rgba(248, 113, 113, 0.14);
  --warn-fg: #F87171;
}
