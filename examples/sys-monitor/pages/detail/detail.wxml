<view class="page {{theme === 'dark' ? 'dark' : ''}}">
  <view wx:if="{{state === 'loading'}}" class="proc-gone">正在获取进程信息…</view>
  <view wx:elif="{{state === 'gone'}}" class="proc-gone">进程已结束</view>
  <view wx:elif="{{state === 'error'}}" class="proc-gone">{{errMsg}}</view>

  <block wx:else>
    <view class="proc-hero">
      <view class="icon {{isProtected ? 'sys' : ''}}">{{iconChar}}</view>
      <view class="name">{{name}}</view>
      <view class="mem">{{memText}}</view>
      <view class="cpu">CPU {{cpuText}}</view>
      <view class="of" wx:if="{{memOf}}">{{memOf}}</view>
    </view>

    <view class="card">
      <view class="card-title">明细</view>
      <view class="row"><text class="label">进程 ID(PID)</text><text class="value">{{dPid}}</text></view>
      <view class="row"><text class="label">CPU 占用</text><text class="value">{{dCpu}}</text></view>
      <view class="row"><text class="label">内存占用</text><text class="value">{{dMem}}</text></view>
      <view class="row"><text class="label">已运行</text><text class="value">{{dElapsed}}</text></view>
      <view class="row"><text class="label">路径</text><text class="value cmd">{{dCommand}}</text></view>
    </view>

    <view class="kill-wrap">
      <view wx:if="{{!isProtected}}" class="kill-btn {{killing ? 'busy' : ''}}" bindtap="onKill">退出此进程</view>
      <view class="kill-note" wx:if="{{isProtected}}">系统关键进程(如 kernel_task / WindowServer),不提供退出按钮,防止误杀导致系统卡死</view>
      <view class="kill-note" wx:else>将向该进程发送结束信号(SIGTERM),给它正常收尾的机会</view>
    </view>
  </block>
</view>
