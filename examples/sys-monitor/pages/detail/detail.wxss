/* 进程详情页样式:对齐原版 baigong h5 定稿(rpx = h5 px × 2)。
   颜色用 app.wxss 的深浅色变量,语义色(橙/蓝/红)明暗同值不走变量。 */
.page { padding: 4rpx 24rpx 32rpx; }

.proc-hero {
  background: var(--card); border-radius: 28rpx;
  padding: 44rpx 32rpx 36rpx; margin-top: 16rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
  display: flex; flex-direction: column; align-items: center;
}
.proc-hero .icon {
  width: 88rpx; height: 88rpx; border-radius: 20rpx; background: var(--chip);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: #2563EB; margin-bottom: 12rpx;
}
.proc-hero .icon.sys { color: var(--fg2); }
.proc-hero .name {
  font-size: 30rpx; font-weight: 700; max-width: 100%;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.proc-hero .mem { font-size: 60rpx; font-weight: 800; color: #F59E0B; margin-top: 8rpx; }
.proc-hero .cpu { font-size: 26rpx; font-weight: 700; color: #2563EB; margin-top: 8rpx; }
.proc-hero .of { font-size: 22rpx; color: var(--fg3); margin-top: 8rpx; }

.card {
  background: var(--card); border-radius: 28rpx;
  padding: 28rpx 32rpx; margin-top: 20rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--divider);
  font-size: 26rpx;
}
.row:last-of-type { border-bottom: 0; }
.row .label { color: var(--fg2); flex-shrink: 0; margin-right: 24rpx; }
.row .value { font-weight: 700; text-align: right; word-break: break-all; }
.row .value.cmd { font-size: 24rpx; font-weight: 400; }

.kill-wrap { padding-bottom: 12rpx; }
.kill-btn {
  background: #EF4444; color: #FFFFFF;
  font-size: 30rpx; font-weight: 700;
  padding: 26rpx 0; border-radius: 24rpx;
  width: 100%; margin-top: 28rpx; text-align: center;
}
.kill-btn.busy { opacity: 0.6; }
.kill-note { font-size: 22rpx; color: var(--fg3); text-align: center; margin-top: 20rpx; line-height: 1.5; }

.proc-gone {
  background: var(--card); border-radius: 28rpx;
  padding: 80rpx 32rpx; margin-top: 16rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
  text-align: center; font-size: 28rpx; color: var(--fg2);
}
