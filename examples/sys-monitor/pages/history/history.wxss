/* 近 24 小时页样式:对齐原版 baigong h5 定稿(rpx = h5 px × 2)。
   颜色用 app.wxss 的深浅色变量,语义三色明暗同值不走变量。 */
.page { padding: 4rpx 24rpx 32rpx; }

.card {
  background: var(--card); border-radius: 28rpx;
  padding: 28rpx 32rpx; margin-top: 20rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--divider);
  font-size: 26rpx;
}
.row:last-of-type { border-bottom: 0; }
.row .label { color: var(--fg2); flex-shrink: 0; margin-right: 24rpx; }
.row .value { font-weight: 700; text-align: right; word-break: break-all; }

/* 图例 */
.legend { display: flex; align-items: center; padding: 4rpx 0 12rpx; }
.sw { display: flex; align-items: center; margin-right: 32rpx; font-size: 24rpx; color: var(--fg2); }
.sw .ln { width: 28rpx; height: 6rpx; border-radius: 4rpx; margin-right: 12rpx; }
.sw .ln.blue { background: #2563EB; }
.sw .ln.orange { background: #F59E0B; }
.sw .ln.red { background: #EF4444; }

.chart-canvas { width: 100%; height: 400rpx; }
.xticks { display: flex; justify-content: space-between; padding-top: 8rpx; }
.xtick { font-size: 20rpx; color: var(--fg3); }
.chart-empty { font-size: 24rpx; color: var(--fg3); text-align: center; padding: 120rpx 0; }

.hint { text-align: center; font-size: 22rpx; color: var(--fg3); margin-top: 28rpx; }
