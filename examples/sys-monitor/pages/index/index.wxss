/* 实时概览样式:对齐原版 baigong h5 定稿(rpx = h5 px × 2)。
   颜色用 app.wxss 的深浅色变量,语义三色明暗同值不走变量。 */
.page { padding: 4rpx 24rpx 32rpx; }

/* 头部 live 行 */
.live { display: flex; align-items: center; padding: 12rpx 8rpx 0; }
.live .dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #10B981; margin-right: 12rpx; }
.live.err .dot { background: #EF4444; }
.live-text { font-size: 24rpx; color: var(--fg3); }

/* ── 三圆环 ─────────────────────────────────────────────── */
.rings { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ring-card {
  flex: 1; background: var(--card); border-radius: 28rpx;
  padding: 28rpx 12rpx 24rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
  display: flex; flex-direction: column; align-items: center; min-width: 0;
}
.ring-wrap { position: relative; width: 128rpx; height: 128rpx; }
.ring-canvas { width: 128rpx; height: 128rpx; }
.ring-pct {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: var(--fg);
}
.ring-label { font-size: 26rpx; font-weight: 600; margin-top: 12rpx; }
.ring-sub { font-size: 22rpx; color: var(--fg3); margin-top: 8rpx; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ── 卡片与明细行 ───────────────────────────────────────── */
.card {
  background: var(--card); border-radius: 28rpx;
  padding: 28rpx 32rpx; margin-top: 20rpx; box-shadow: 0 2rpx 6rpx var(--shadow);
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--divider);
  font-size: 26rpx;
}
.row:last-of-type { border-bottom: 0; }
.row .label { color: var(--fg2); flex-shrink: 0; margin-right: 24rpx; }
.row .value { font-weight: 700; text-align: right; word-break: break-all; }
.row .value .soft { font-weight: 400; color: var(--fg2); font-size: 24rpx; }
.trend { color: #10B981; font-weight: 400; font-size: 24rpx; }

/* 进度条(内存/存储卡) */
.bar { height: 16rpx; border-radius: 8rpx; background: var(--track); overflow: hidden; margin: 16rpx 0 4rpx; }
.bar .fill { height: 100%; border-radius: 8rpx; }
.bar .fill.mem { background: #F59E0B; }
.bar .fill.disk { background: #EF4444; }

/* ≥85% 飘红警示条 */
.warnbox {
  margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 16rpx;
  background: var(--warn-bg); color: var(--warn-fg);
  font-size: 24rpx; font-weight: 600;
}

/* 存储卡首行(左摘要右 pct) */
.disk-head { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12rpx; font-size: 26rpx; }
.disk-head .used-avail { color: var(--fg2); }
.disk-head .pct { font-weight: 700; }

/* ── 占用 Top 10 ────────────────────────────────────────── */
.proc-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.proc-head .ptitle { margin-bottom: 0; }
.seg { display: inline-flex; background: var(--chip); border-radius: 16rpx; padding: 4rpx; }
.seg-btn {
  font-size: 22rpx; font-weight: 600; color: var(--fg2);
  padding: 6rpx 20rpx; border-radius: 12rpx;
}
.seg-btn.active { background: var(--seg-active); color: #2563EB; box-shadow: 0 2rpx 6rpx var(--shadow); }
.proc-sub { font-size: 22rpx; color: var(--fg3); }
.proc-row {
  display: flex; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--divider);
  min-width: 0;
}
.proc-row:last-of-type { border-bottom: 0; }
.proc-rank {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; color: var(--fg2); background: var(--chip-soft);
  margin-right: 20rpx;
}
.proc-row.top3 .proc-rank { color: #FFFFFF; background: #F59E0B; }
.proc-name {
  flex: 1; min-width: 0; font-size: 26rpx; font-weight: 600; color: var(--fg);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-right: 16rpx;
}
.proc-cpu { font-size: 24rpx; font-weight: 700; color: #2563EB; flex-shrink: 0; margin-right: 16rpx; }
.proc-mem { font-size: 24rpx; font-weight: 700; color: #F59E0B; flex-shrink: 0; }
.proc-empty { font-size: 24rpx; color: var(--fg3); text-align: center; padding: 36rpx 0 16rpx; }

.hint { text-align: center; font-size: 22rpx; color: var(--fg3); margin-top: 28rpx; }
