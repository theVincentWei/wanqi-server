{
  "pages": ["pages/index/index", "pages/history/history", "pages/detail/detail"],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "系统监视器",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "borderStyle": "@tabBorderStyle",
    "backgroundColor": "@tabBgColor",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "实时概览",
        "iconPath": "assets/tab/live.png",
        "selectedIconPath": "assets/tab/live-active.png"
      },
      {
        "pagePath": "pages/history/history",
        "text": "近 24 小时",
        "iconPath": "assets/tab/history.png",
        "selectedIconPath": "assets/tab/history-active.png"
      }
    ]
  }
}
