/* 双拼教练 · 全局变量组（内容层深浅色必须 JS 驱动：页面根节点挂 .dark，见 utils/theme.js） */
.page {
  --bg: #F0F3F7;
  --panel: #FFFFFF;
  --panel2: #EDF1F6;
  --line: #DFE6EE;
  --fg: #1A2430;
  --fg2: #5F6E80;
  --fg3: #8B98A8;
  --acc: #2F6FD6;
  --accBg: #E3EEFB;
  --hot: #B96E1F;
  --hotBg: #FBF0E0;
  --ok: #1FA564;
  --okBg: #E2F5EC;
  --err: #D64545;
  --track: #E3E9F0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--fg);
  box-sizing: border-box;
  font-size: 28rpx;
}
.page.dark {
  --bg: #0D1117;
  --panel: #171E27;
  --panel2: #1D2632;
  --line: #273241;
  --fg: #E9EEF4;
  --fg2: #A9B7C8;
  --fg3: #8B98A8;
  --acc: #4D9DFF;
  --accBg: #152639;
  --hot: #FFB765;
  --hotBg: #332614;
  --ok: #4ADE8F;
  --okBg: #132A1F;
  --err: #FF7D7D;
  --track: #232D3A;
}

/* 通用卡片 */
.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx 24rpx;
  margin: 16rpx 32rpx 0;
}
.card-title {
  font-size: 25rpx;
  color: var(--fg3);
  font-weight: 600;
}

/* 通用分段控件 */
.seg { display: flex; background: var(--panel2); border-radius: 18rpx; padding: 5rpx; }
.seg-i { flex: 1; text-align: center; padding: 13rpx 0; border-radius: 14rpx; font-size: 25rpx; color: var(--fg3); }
.seg-i.on { background: #2B3A4D; color: #FFFFFF; font-weight: 600; }
.page:not(.dark) .seg-i.on { background: #DCE7F5; color: var(--acc); }
