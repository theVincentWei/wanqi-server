/* 练习页 · mockup S2（390px → rpx ×1.92）；颜色一律 var(--*) */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶栏 */
.ptop {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 15rpx 32rpx 4rpx;
}
.xbtn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--panel2);
  color: var(--fg2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  flex: none;
}
.pwrap {
  flex: 1;
  min-width: 0;
}
.plabel {
  font-size: 21rpx;
  color: var(--fg3);
  margin-bottom: 8rpx;
}
.pbar {
  height: 12rpx;
  background: var(--track);
  border-radius: 6rpx;
  overflow: hidden;
}
.pbar-i {
  display: block;
  height: 100%;
  background: var(--acc);
  border-radius: 6rpx;
}
.tmr,
.accp {
  font-size: 23rpx;
  color: var(--fg3);
  background: var(--panel2);
  padding: 8rpx 15rpx;
  border-radius: 15rpx;
  flex: none;
}
.bulb {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--panel2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  flex: none;
}
.bulb.off {
  filter: grayscale(1);
  opacity: 0.55;
}
.bulb.on {
  background: var(--hotBg);
  border: 1rpx solid var(--hot);
}
.bulb.dis {
  opacity: 0.4;
  filter: grayscale(1);
}

/* 题卡 */
.syll {
  margin: 23rpx 32rpx 0;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  text-align: center;
  padding: 38rpx 32rpx 32rpx;
}
.zi-line {
  line-height: 1.12;
}
.zi {
  font-size: 134rpx;
  font-weight: 700;
  line-height: 1.12;
}
.tagc {
  font-size: 23rpx;
  color: var(--fg3);
  background: var(--panel2);
  border-radius: 15rpx;
  padding: 6rpx 15rpx;
  vertical-align: 50rpx;
  margin-left: 15rpx;
  font-weight: 400;
}
.py {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  margin-top: 19rpx;
}
.py-sm,
.py-fm {
  font-size: 48rpx;
  padding: 6rpx 23rpx;
  border-radius: 19rpx;
  font-weight: 700;
  line-height: 1.4;
}
/* 声母蓝 / 韵母橙 */
.py-sm {
  color: var(--acc);
  background: var(--accBg);
}
.py-fm {
  color: var(--hot);
  background: var(--hotBg);
}
.hintrow {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  margin-top: 25rpx;
  flex-wrap: wrap;
}
.hint {
  font-size: 23rpx;
  color: var(--fg2);
  background: var(--panel2);
  border-radius: 15rpx;
  padding: 10rpx 19rpx;
}
.hint.dimh {
  opacity: 0.55;
}
.hintb {
  font-size: 23rpx;
  color: var(--fg2);
  background: var(--panel2);
  border-radius: 15rpx;
  padding: 10rpx 19rpx;
}
.hintk {
  color: var(--hot);
  font-weight: 700;
}

/* 听音待答（mockup S3）：大播放钮 + 静态波形 + 提示行 */
.play {
  width: 173rpx;
  height: 173rpx;
  border-radius: 50%;
  background: var(--accBg);
  border: 4rpx solid var(--acc);
  box-sizing: border-box;
  margin: 8rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  color: var(--acc);
  padding-left: 8rpx; /* ▶ 字形光学居中 */
}
.play-dis {
  opacity: 0.4;
}
.wave {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 50rpx;
  margin-top: 25rpx;
}
.wave-i {
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--acc);
  opacity: 0.45;
}
.sub2 {
  margin-top: 23rpx;
  font-size: 23rpx;
  color: var(--fg3);
}

/* 播放链路状态机行（真机截图自证） */
.audio-state {
  margin-top: 19rpx;
  font-size: 23rpx;
  min-height: 32rpx;
}

/* 听音主播放界面：原生 controls 元素（自带播放键+进度条，用户手势直点必响） */
.audiowrap {
  width: 80%;
  margin: 20rpx auto 0;
}
.audiowrap audio {
  width: 100%;
}
.st-loading {
  color: var(--fg3);
}
.st-ready {
  color: var(--ok);
}
.st-retry {
  color: var(--hot);
}
.st-unreachable {
  color: var(--err);
}

/* 键序槽位 */
.slots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 19rpx;
  margin-top: 54rpx;
}
.slot {
  width: 119rpx;
  height: 119rpx;
  border-radius: 26rpx;
  background: var(--panel2);
  border: 4rpx solid var(--line);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 700;
  color: var(--fg);
}
.slot.cur {
  border-color: var(--acc);
}
.slot.ok {
  background: var(--okBg);
  border-color: var(--ok);
  color: var(--ok);
}
.slot.err {
  border-color: var(--err);
  color: var(--err);
}
.caret {
  width: 4rpx;
  height: 54rpx;
  background: var(--acc);
  animation: sp-blink 1s step-end infinite;
}
@keyframes sp-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.verdict {
  text-align: center;
  margin-top: 23rpx;
  font-size: 25rpx;
  color: var(--fg3);
  min-height: 38rpx;
}
.verdict.ok {
  color: var(--ok);
}
.verdict.err {
  color: var(--err);
}
.vk {
  color: var(--hot);
  font-weight: 700;
}

/* 系统键盘模式 */
.sysbox {
  margin: 23rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.syslabel {
  margin-top: 23rpx;
  font-size: 23rpx;
  color: var(--fg3);
}
.sysrow {
  margin-top: 19rpx;
  width: 78%;
  display: flex;
  align-items: center;
}
.sysinput {
  flex: 1;
  height: 96rpx;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--fg);
}
.sysjudge {
  width: 96rpx;
  height: 96rpx;
  margin-left: 14rpx;
  border-radius: 20rpx;
  background: var(--accBg);
  color: var(--acc);
  border: 1rpx solid var(--acc);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.sysph {
  color: var(--fg3);
  font-size: 26rpx;
}

/* 键盘：吸底 */
.kbwrap {
  margin-top: auto;
  padding: 24rpx 20rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
