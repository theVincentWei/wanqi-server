<view class="page {{theme==='dark'?'dark':''}}">

  <view class="ptop">
    <view class="xbtn" bindtap="onClose">✕</view>
    <view class="pwrap" wx:if="{{ready}}">
      <view class="plabel">{{idx + 1}} / {{total}}</view>
      <view class="pbar"><view class="pbar-i" style="width:{{progress}}%"></view></view>
    </view>
    <view class="pwrap" wx:else><view class="plabel">准备中…</view></view>
    <view class="tmr">⏱ {{clock}}</view>
    <view class="accp">{{accText}}</view>
    <view class="bulb {{mode==='listen' ? 'dis' : (hint ? 'on' : 'off')}}" bindtap="toggleHint">💡</view>
  </view>

  <block wx:if="{{q}}">
    <view class="syll">
      <!-- 看拼全程 / 听音判分后揭示：字 + 拼音 + 例词 -->
      <block wx:if="{{mode !== 'listen' || vType}}">
        <view class="zi-line">
          <text class="zi">{{q.char}}</text>
          <text class="tagc" wx:if="{{tagText}}">{{tagText}}</text>
        </view>
        <view class="py">
          <text class="py-sm" wx:if="{{q.smText}}">{{q.smText}}</text>
          <text class="py-fm">{{q.fmText}}</text>
        </view>
        <view class="hintrow" wx:if="{{mode !== 'listen' && hint}}">
          <view class="hintb"><text>{{q.h1t}}</text><text class="hintk">{{q.h1k}}</text></view>
          <view class="hintb"><text>{{q.h2t}}</text><text class="hintk">{{q.h2k}}</text></view>
        </view>
        <view class="hintrow" wx:elif="{{mode !== 'listen'}}">
          <view class="hint dimh">提示已关 · 点右上 💡 开启</view>
        </view>
      </block>

      <!-- 听音待答：只给听（字/拼音/例词/键位全隐藏） -->
      <block wx:else>
        <view
          class="play {{audioState === 'loading' ? 'play-dis' : ''}}"
          bindtap="onPlayTap"
        >▶</view>
        <view class="wave">
          <view class="wave-i" wx:for="{{waveH}}" wx:key="*this" style="height:{{item}}rpx"></view>
        </view>
        <view class="audio-state st-{{audioState}}" wx:if="{{audioStateText}}">{{audioStateText}}</view>
        <view class="sub2">{{listenTip}}</view>
      </block>
    </view>

    <block wx:if="{{input === 'builtin'}}">
      <view class="slots">
        <view class="slot {{cls1}}">{{s1}}<view wx:if="{{!s1 && cls1 === 'cur'}}" class="caret"></view></view>
        <view class="slot {{cls2}}">{{s2}}<view wx:if="{{!s2 && cls2 === 'cur'}}" class="caret"></view></view>
      </view>
      <view class="verdict {{vType}}" wx:if="{{vPre}}">{{vPre}}<text class="vk" wx:if="{{vKeys}}">{{vKeys}}</text></view>
      <view class="verdict" wx:else>&nbsp;</view>
    </block>

    <block wx:else>
      <view class="sysbox">
        <view class="syslabel">用你的输入法打出这个字</view>
        <view class="sysrow">
          <input
            class="sysinput"
            value="{{sysVal}}"
            focus="{{sysFocus}}"
            confirm-type="done"
            bindinput="onSysInput"
            bindconfirm="onSysConfirm"
            bindblur="onSysBlur"
            placeholder="上屏后自动判对错"
            placeholder-class="sysph"
          />
          <view class="sysjudge" bindtap="onSysJudgeTap">判</view>
        </view>
        <view class="verdict {{vType}}" wx:if="{{vPre}}">{{vPre}}<text class="vk" wx:if="{{vKeys}}">{{vKeys}}</text></view>
        <view class="verdict" wx:else>&nbsp;</view>
      </view>
    </block>
  </block>

  <view class="kbwrap" wx:if="{{q && input === 'builtin'}}">
    <kbboard dim="{{!hint}}" highlight="{{hlKeys}}" bindkey="onKey" binddel="onDel" />
  </view>

  <!-- 听音兜底播放器（v7.0 仅降级时显示）：原生主路 = InnerAudioContext 直读包内
       ogg（无 WebView 手势/autoplay 限制），进题自动播、▶ 大按钮随时重听，本条不出现。
       旧容器（缺 wx.createInnerAudioContext）或原生报错 → audioFallback=true，走回
       daemon data-URI 旧链路：WebView autoplay 策略性失效（CDP 实证，插入式/换 src
       均不播），唯一可靠出声 = 用户手势直点 <audio controls> 自带播放键。 -->
  <view class="audiowrap" wx:if="{{q && mode === 'listen' && audioFallback}}">
    <audio id="player" src="{{audioSrc}}" controls binderror="onAudioErr" bindplay="onAudioPlay" bindended="onAudioEnded"></audio>
  </view>

</view>
