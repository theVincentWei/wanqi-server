/* 配置首页 · mockup S1（390px → rpx ×1.92）；颜色一律 var(--*) */
.appbar {
  padding: 16rpx 32rpx 6rpx;
}
.ttl {
  font-size: 42rpx;
  font-weight: 800;
}
.sub {
  font-size: 22rpx;
  color: var(--fg3);
  margin-top: 6rpx;
}

/* 单字/词语 seg：复用全局 .seg，这里只加外边距 */
.seg2 {
  margin: 12rpx 32rpx 0;
}
.seg-i.dis {
  opacity: 0.4;
}

/* 韵母卡 */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.lnks {
  display: flex;
  align-items: center;
}
.lnk {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--acc);
  opacity: 0.7;
}
.lnk-dot {
  margin: 0 8rpx;
  color: var(--fg3);
  font-size: 23rpx;
}
.qrow {
  display: flex;
  gap: 15rpx;
  margin-top: 13rpx;
}
.qbtn {
  font-size: 22rpx;
  color: var(--acc);
  background: var(--accBg);
  border: 1rpx solid var(--accBg);
  border-radius: 15rpx;
  padding: 6rpx 15rpx;
}
.qbtn-w {
  color: var(--hot);
  background: var(--hotBg);
  border-color: var(--hotBg);
}
.qbtn-dis {
  opacity: 0.45;
}
.chips {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
}
.chip {
  display: inline-block;
  padding: 8rpx 15rpx;
  border-radius: 17rpx;
  background: var(--panel2);
  color: var(--fg3);
  font-size: 22rpx;
  margin: 6rpx 6rpx 0 0;
  border: 1rpx solid transparent;
  line-height: 1.3;
}
.chip.on {
  background: var(--accBg);
  color: var(--acc);
  border-color: var(--acc);
  font-weight: 600;
}

/* 出题模式 */
.opt {
  display: flex;
  align-items: center;
  gap: 19rpx;
  border: 1rpx solid var(--line);
  border-radius: 23rpx;
  padding: 13rpx 19rpx;
  margin-top: 12rpx;
}
.opt.on {
  border-color: var(--acc);
  background: var(--accBg);
}
.opt-dis {
  opacity: 0.45;
}
.radio {
  width: 31rpx;
  height: 31rpx;
  border-radius: 50%;
  border: 4rpx solid var(--fg3);
  flex: none;
  box-sizing: border-box;
}
.opt.on .radio {
  border: 10rpx solid var(--acc);
  background: var(--bg);
}
.ic {
  font-size: 35rpx;
  flex: none;
}
.opt-main {
  flex: 1;
  min-width: 0;
}
.opt-b {
  font-size: 26rpx;
  font-weight: 600;
}
.opt-s {
  font-size: 21rpx;
  color: var(--fg3);
  margin-top: 4rpx;
}
.opt-s.warn {
  color: var(--hot);
}
.tag {
  font-size: 20rpx;
  color: var(--ok);
  border: 1rpx solid var(--ok);
  border-radius: 13rpx;
  padding: 4rpx 12rpx;
  flex: none;
}

/* 输入与提示 */
.lrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 17rpx;
  gap: 16rpx;
}
.lrow-l {
  font-size: 25rpx;
  color: var(--fg3);
  flex: 1;
  min-width: 0;
}
.lrow-r {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex: none;
}
/* 宽度按内容收缩的分段（复用全局 .seg 配色） */
.seg-auto {
  flex: none;
}
.seg-auto .seg-i {
  padding: 10rpx 19rpx;
  font-size: 24rpx;
}
.swt {
  font-size: 23rpx;
  color: var(--fg3);
}
/* 自绘 switch（mockup .sw）：颜色全走变量 */
.sw {
  width: 77rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: var(--track);
  position: relative;
  flex: none;
}
.sw-i {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 35rpx;
  height: 35rpx;
  border-radius: 50%;
  background: var(--fg3);
}
.sw.on {
  background: var(--accBg);
}
.sw.on .sw-i {
  left: auto;
  right: 4rpx;
  background: var(--acc);
}

/* CTA：吸底（tabBar 之上） */
.cta {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--acc);
  border-radius: 23rpx;
  padding: 23rpx 0;
  text-align: center;
  font-size: 31rpx;
  font-weight: 700;
  color: #ffffff;
  z-index: 5;
}
.cta-space {
  height: 160rpx;
}
