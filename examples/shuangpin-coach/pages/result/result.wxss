/* 结果页 · mockup S5（390px → rpx ×1.92）；颜色一律 var(--*) */
.rhead {
  padding: 38rpx 32rpx 4rpx;
  font-size: 42rpx;
  font-weight: 700;
}
.rsub {
  font-size: 23rpx;
  color: var(--fg3);
  margin-top: 12rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.lnk {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--acc);
  opacity: 0.7;
}

/* 分数卡：圆环 + 指标列表 */
.score {
  display: flex;
  align-items: center;
  gap: 31rpx;
}
.ringwrap {
  position: relative;
  width: 216rpx;
  height: 216rpx;
  flex: none;
}
.ring {
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
}
.ring-hole {
  position: absolute;
  left: 19rpx;
  top: 19rpx;
  width: 178rpx;
  height: 178rpx;
  border-radius: 50%;
  background: var(--panel);
}
.ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ringnum {
  font-size: 50rpx;
  font-weight: 700;
  color: var(--ok);
  line-height: 1.2;
}
.ringlbl {
  font-size: 21rpx;
  color: var(--fg3);
}
.slist {
  flex: 1;
  min-width: 0;
}
.srow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: var(--fg3);
  border-bottom: 1rpx dashed var(--line);
}
.srow:last-child {
  border-bottom: none;
}
.sv {
  color: var(--fg);
  font-size: 25rpx;
  font-weight: 600;
}
.errc {
  color: var(--err);
}

/* 迷你曲线容器（linechart mini 填满） */
.trendbox {
  margin-top: 12rpx;
  height: 170rpx;
  width: 100%;
}

/* 错题列表 */
.miss {
  display: flex;
  align-items: center;
  gap: 23rpx;
  margin-top: 19rpx;
  background: var(--panel2);
  border-radius: 19rpx;
  padding: 17rpx 23rpx;
}
.mz {
  font-size: 42rpx;
  font-weight: 700;
  width: 65rpx;
  text-align: center;
  flex: none;
}
.mm {
  flex: 1;
  min-width: 0;
}
.mm-b {
  font-size: 25rpx;
  font-weight: 600;
}
.mm-s {
  font-size: 23rpx;
  color: var(--fg3);
  margin-top: 6rpx;
}
.strike {
  text-decoration: line-through;
}
.hk {
  color: var(--hot);
  font-weight: 700;
}
.miss-empty {
  margin-top: 19rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--fg3);
  padding: 17rpx 0;
}

/* 底部双按钮 */
.rbt {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 19rpx;
  z-index: 5;
}
.bpri {
  flex: 1.4;
  background: var(--acc);
  color: #ffffff;
  border-radius: 23rpx;
  padding: 25rpx 0;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}
.bpri.dis {
  opacity: 0.45;
}
.bgho {
  flex: 1;
  border: 1rpx solid var(--line);
  color: var(--fg2);
  border-radius: 23rpx;
  padding: 25rpx 0;
  text-align: center;
  font-size: 27rpx;
}
.rbt-space {
  height: 180rpx;
}
