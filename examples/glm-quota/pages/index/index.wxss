.page { padding: 24rpx; }
.card { background: #1d1f27; border-radius: 20rpx; padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.err { background: #3a1d1f; color: #f2a5a8; border-radius: 14rpx; padding: 20rpx; margin-bottom: 24rpx; font-size: 26rpx; }

.nokey {
  background: #1d1f27; border: 2rpx dashed #3a4048; border-radius: 20rpx;
  padding: 56rpx 24rpx; text-align: center; margin-bottom: 24rpx;
}
.nokey-t { font-size: 32rpx; color: #e8eaed; font-weight: 600; margin-bottom: 14rpx; }
.nokey-s { font-size: 24rpx; color: #9aa1a9; }

.hero {
  background: linear-gradient(160deg, #232a3a 0%, #1d1f27 60%);
  border-radius: 20rpx; padding: 30rpx 24rpx; margin-bottom: 24rpx;
}
.row-between { display: flex; justify-content: space-between; align-items: center; }
.card-title { font-size: 28rpx; color: #c9ced4; font-weight: 600; }
.badge {
  font-size: 20rpx; color: #7cb8ff; background: rgba(47, 111, 235, 0.16);
  padding: 6rpx 16rpx; border-radius: 20rpx;
}
.badge.lv { color: #6fd28c; background: rgba(111, 210, 140, 0.14); margin-right: 12rpx; }
.hero-pct { font-size: 72rpx; font-weight: 700; color: #7cb8ff; margin: 12rpx 0 4rpx; }
.hero-pct.warn { color: #e8a23d; }
.hero-pct.danger { color: #e5484d; }
.bar { height: 12rpx; background: #2a2d34; border-radius: 6rpx; margin: 12rpx 0; overflow: hidden; }
.bar.big { height: 16rpx; border-radius: 8rpx; }
.fill { height: 100%; background: #2f6feb; border-radius: 6rpx; }
.fill.warn { background: #e8a23d; }
.fill.danger { background: #e5484d; }
.sub { font-size: 24rpx; color: #9aa1a9; }
.sub.dim { color: #6d737b; }

.nums { display: flex; margin: 20rpx 0 6rpx; }
.num { flex: 1; display: flex; flex-direction: column; align-items: center; }
.nv { font-size: 40rpx; font-weight: 700; color: #e8eaed; }
.nv.hi { color: #6fd28c; }
.nl { font-size: 22rpx; color: #6d737b; margin-top: 4rpx; }

.divider { height: 1px; background: #2a2d34; margin: 20rpx 0; }
.detail { display: flex; align-items: center; margin-bottom: 12rpx; }
.dcode { width: 200rpx; font-size: 24rpx; color: #9aa1a9; }
.dshare { flex: 1; height: 8rpx; background: #2a2d34; border-radius: 4rpx; overflow: hidden; margin: 0 16rpx; }
.dfill { height: 100%; background: #5a8fd6; border-radius: 4rpx; }
.dnum { width: 110rpx; text-align: right; font-size: 24rpx; color: #c9ced4; }

.chips { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip {
  font-size: 22rpx; color: #9aa1a9; background: #262a33;
  padding: 8rpx 18rpx; border-radius: 12rpx; margin: 0 12rpx 12rpx 0;
}

.updated { font-size: 22rpx; color: #6d737b; text-align: center; margin-top: 8rpx; }
.hint { color: #6d737b; font-size: 26rpx; text-align: center; margin-top: 80rpx; }
